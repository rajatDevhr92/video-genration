import json
import shutil

from .composition_generator import CompositionGenerator
from .config import OUTPUT_DIR
from .keyframe_generator import KeyframeGenerator
from .video_generator import VideoGenerator
from .video_utils import extract_last_frame


class SceneManager:

    def __init__(self):
        self.composition_generator = (
            CompositionGenerator()
        )

        self.keyframe_generator = (
            KeyframeGenerator()
        )

        self.video_generator = (
            VideoGenerator()
        )

    @staticmethod
    def build_motion_prompt(scene):
        return f"""
Animate this established cinematic scene naturally.

Scene:
{scene.get("description", "")}

Action:
{scene.get("action", "")}

Camera movement:
{scene.get("camera", "")}

Lighting:
{scene.get("lighting", "")}

The input keyframe is the visual authority for:
- character identity
- character clothing
- environment
- architecture
- spatial layout
- lighting
- weather
- time of day

Introduce realistic motion only.

Natural human movement.
Natural clothing movement.
Physically believable rain.
Natural environmental motion.
Subtle atmospheric motion.
Cinematic camera movement.

Do not redesign the characters.
Do not change their faces.
Do not change their clothing.
Do not change the location.
Do not introduce additional characters.
Do not create a different scene.
Do not create a collage or split screen.
"""

    @staticmethod
    def build_scene_state(
        scene,
        previous_state=None,
    ):
        """
        Build explicit continuity state for the current scene.

        State is intentionally derived from the story plan and
        previous scene state. It does not invent persistent objects.
        """
        previous_state = previous_state or {}

        state = {
            "scene_id": scene.get("id"),
            "order": scene.get("order"),
            "location": scene.get(
                "location_id"
            ),
            "characters": list(
                scene.get(
                    "character_ids",
                    []
                )
            ),
            "weather": scene.get(
                "weather"
            ),
            "lighting": scene.get(
                "lighting"
            ),
            "objects": dict(
                previous_state.get(
                    "objects",
                    {}
                )
            ),
            "notes": list(
                previous_state.get(
                    "notes",
                    []
                )
            ),
        }

        # Optional continuity section generated by the planner.
        continuity = scene.get(
            "continuity"
        )

        if isinstance(continuity, dict):

            persistent_objects = continuity.get(
                "persistent_objects",
                []
            )

            if isinstance(
                persistent_objects,
                list,
            ):
                for obj in persistent_objects:

                    if not isinstance(
                        obj,
                        dict,
                    ):
                        continue

                    obj_id = obj.get("id")

                    if obj_id:
                        state["objects"][obj_id] = obj

            continuity_notes = continuity.get(
                "notes",
                []
            )

            if isinstance(
                continuity_notes,
                list,
            ):
                state["notes"].extend(
                    continuity_notes
                )

            elif continuity_notes:
                state["notes"].append(
                    continuity_notes
                )

        return state

    def generate_keyframes(
        self,
        job_id,
        story_plan,
        references,
        start_scene=1,
        end_scene=None,
    ):
        job_dir = OUTPUT_DIR / job_id

        scenes = story_plan.get(
            "scenes",
            []
        )

        if not scenes:
            raise RuntimeError(
                "Story plan contains no scenes."
            )

        if end_scene is None:
            end_scene = len(scenes)

        results = []

        previous_last_frame = None
        previous_scene_state = None

        character_map = {
            character["id"]: character
            for character in story_plan.get(
                "characters",
                []
            )
        }

        for scene in scenes:

            order = int(
                scene["order"]
            )

            if order < start_scene:
                continue

            if order > end_scene:
                break

            scene_id = scene["id"]

            # --------------------------------------------------
            # Persistent scene state
            # --------------------------------------------------

            scene_state = (
                self.build_scene_state(
                    scene,
                    previous_scene_state,
                )
            )

            scene_dir = (
                job_dir
                / "scenes"
                / scene_id
            )

            scene_dir.mkdir(
                parents=True,
                exist_ok=True,
            )

            composition_path = (
                scene_dir
                / "composition.png"
            )

            keyframe_path = (
                scene_dir
                / "keyframe.png"
            )

            video_path = (
                scene_dir
                / "video.mp4"
            )

            last_frame_path = (
                scene_dir
                / "last_frame.png"
            )

            # --------------------------------------------------
            # Character references
            # --------------------------------------------------

            scene_character_ids = scene.get(
                "character_ids",
                []
            )

            character_refs = []
            scene_characters = []

            for char_id in scene_character_ids:

                reference = references.get(
                    char_id
                )

                if not reference:
                    raise RuntimeError(
                        f"No character reference found "
                        f"for '{char_id}' in scene "
                        f"'{scene_id}'."
                    )

                character_refs.append(
                    reference
                )

                character = character_map.get(
                    char_id
                )

                if character:
                    scene_characters.append(
                        character
                    )

            if not character_refs:
                raise RuntimeError(
                    f"Scene '{scene_id}' contains no characters."
                )

            if len(character_refs) > 3:
                raise RuntimeError(
                    f"Scene '{scene_id}' contains "
                    f"{len(character_refs)} character references. "
                    f"Maximum supported is 3."
                )

            # --------------------------------------------------
            # Stage 1
            #
            # Scene 1:
            #     Qwen T2I creates initial composition.
            #
            # Scene 2+:
            #     Actual last frame of previous video is reused.
            # --------------------------------------------------

            if previous_last_frame is None:

                print()
                print("=" * 80)
                print(
                    f"SCENE {order}: "
                    f"GENERATING INITIAL COMPOSITION"
                )
                print("=" * 80)

                composition_result = (
                    self.composition_generator.generate(
                        scene=scene,
                        characters=scene_characters,
                        output_path=composition_path,
                        seed=1000003 + order * 7919,
                    )
                )

                base_image = (
                    composition_path
                )

                base_source = (
                    "qwen_t2i"
                )

            else:

                print()
                print("=" * 80)
                print(
                    f"SCENE {order}: "
                    f"USING PREVIOUS VIDEO LAST FRAME"
                )
                print("=" * 80)

                print(
                    "Previous last frame:",
                    previous_last_frame,
                )

                shutil.copy2(
                    previous_last_frame,
                    composition_path,
                )

                base_image = (
                    composition_path
                )

                base_source = (
                    "previous_video_last_frame"
                )

                composition_result = {
                    "prompt_id": None
                }

            # --------------------------------------------------
            # Stage 2: Qwen Image Edit
            # --------------------------------------------------

            print()
            print("=" * 80)
            print(
                f"SCENE {order}: "
                f"GENERATING CONTINUITY KEYFRAME"
            )
            print("=" * 80)

            if previous_last_frame:

                continuity_instruction = f"""
This scene continues directly from the actual
last frame of the previous video.

Previous last frame:
{previous_last_frame}

Maintain continuity of:
- character identity
- clothing
- environment
- weather
- lighting
- time of day
- spatial direction
- visual style

Advance the story according to the NEW scene
description. Do not simply copy the previous frame.
"""

            else:

                continuity_instruction = """
This is the opening scene.

Establish the visual world, characters,
environment and cinematic language of the story.
"""

            keyframe_prompt = f"""
Create ONE SINGLE FINAL CINEMATIC FRAME.

{continuity_instruction}

Scene:
{scene.get("description", "")}

Action:
{scene.get("action", "")}

Camera:
{scene.get("camera", "")}

Lighting:
{scene.get("lighting", "")}

Continuity state:
{json.dumps(
    scene_state,
    ensure_ascii=False,
    indent=2,
)}

Use the supplied character reference images to
preserve exact character identities.

Requirements:

ONE continuous frame.
ONE shot.
ONE camera angle.
No collage.
No split screen.
No storyboard.
No multiple panels.
No duplicated characters.
No alternate character views.
No text or subtitles.

Photorealistic high-end feature-film quality.
"""

            keyframe_result = (
                self.keyframe_generator.generate(
                    scene_image=base_image,
                    character_references=character_refs,
                    prompt=keyframe_prompt,
                    output_path=keyframe_path,
                    seed=2000003 + order * 7919,
                )
            )

            # --------------------------------------------------
            # Stage 3: Wan 2.2 I2V
            # --------------------------------------------------

            print()
            print("=" * 80)
            print(
                f"SCENE {order}: "
                f"GENERATING WAN 2.2 VIDEO"
            )
            print("=" * 80)

            motion_prompt = (
                self.build_motion_prompt(
                    scene
                )
            )

            video_result = (
                self.video_generator.generate(
                    keyframe=keyframe_path,
                    motion_prompt=motion_prompt,
                    output_path=video_path,
                    seed=3000003 + order * 7919,
                )
            )

            # --------------------------------------------------
            # Stage 4: extract ACTUAL final video frame
            # --------------------------------------------------

            print()
            print("=" * 80)
            print(
                f"SCENE {order}: "
                f"EXTRACTING LAST FRAME"
            )
            print("=" * 80)

            extract_last_frame(
                video_path,
                last_frame_path,
            )

            # --------------------------------------------------
            # Metadata
            # --------------------------------------------------

            metadata = {
                "scene_id": scene_id,
                "order": order,

                "character_ids": (
                    scene_character_ids
                ),

                "character_references": (
                    character_refs
                ),

                "composition": (
                    str(
                        composition_path
                    )
                ),

                "composition_source": (
                    base_source
                ),

                "keyframe": (
                    str(
                        keyframe_path
                    )
                ),

                "video": (
                    str(
                        video_path
                    )
                ),

                "last_frame": (
                    str(
                        last_frame_path
                    )
                ),

                "previous_last_frame": (
                    str(
                        previous_last_frame
                    )
                    if previous_last_frame
                    else None
                ),

                "composition_prompt_id": (
                    composition_result.get(
                        "prompt_id"
                    )
                ),

                "keyframe_prompt_id": (
                    keyframe_result.get(
                        "prompt_id"
                    )
                ),

                "video_prompt_id": (
                    video_result.get(
                        "prompt_id"
                    )
                ),

                "video_generation_time_seconds": (
                    video_result.get(
                        "generation_time_seconds"
                    )
                ),

                "scene_state": (
                    scene_state
                ),
            }

            with open(
                scene_dir / "metadata.json",
                "w",
                encoding="utf-8",
            ) as f:
                json.dump(
                    metadata,
                    f,
                    indent=2,
                    ensure_ascii=False,
                )

            results.append(
                metadata
            )

            # --------------------------------------------------
            # Current scene becomes continuity state
            # for the next scene.
            # --------------------------------------------------

            previous_last_frame = (
                last_frame_path
            )

            previous_scene_state = (
                scene_state
            )

        return results